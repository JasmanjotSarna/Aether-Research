# ==============================================================================
# Aether Research — environment configuration (all keys are OPTIONAL)
# ==============================================================================
# The app works with zero keys: keyless Wikipedia + arXiv + OpenAlex search and
# a deterministic extractive paper writer. Add a free Groq or OpenRouter key to
# unlock conversational chat and full AI synthesis of research papers.
# ==============================================================================

# --- Primary LLM: Groq free tier ----------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional smaller/faster model for the planner and critic JSON calls.
# Defaults to GROQ_MODEL when unset.
GROQ_JSON_MODEL=

# --- Secondary LLM: OpenRouter free models ------------------------------------
# https://openrouter.ai/keys
# Only "openrouter/free" or ids ending in ":free" are accepted. Paid ids are
# dropped by code, so a misconfigured model can never be billed.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Optional smaller/faster free model for JSON calls. Defaults to the first
# entry of OPENROUTER_MODELS.
OPENROUTER_JSON_MODEL=

# --- Optional search: Tavily ---------------------------------------------------
# Keyless search always works. Tavily adds broader general-web coverage.
# https://app.tavily.com
TAVILY_API_KEY=

# --- Browser-supplied keys (optional) ------------------------------------------
# A browser may send per-request keys instead of using the env vars above:
#   x-groq-key, x-openrouter-key, x-tavily-key
# BYOK requests skip the server-side 6-runs/hour research limit. Keys are never
# returned, logged or stored.

# --- OpenRouter attribution headers (optional) --------------------------------
APP_URL=https://aether-research.vercel.app
APP_NAME=Aether Research

# --- Development only: point a provider at the local mock server ---------------
# GROQ_BASE_URL=http://127.0.0.1:4010/v1/chat/completions
# OPENROUTER_BASE_URL=http://127.0.0.1:4010/v1/chat/completions
